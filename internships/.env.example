# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Supabase transaction pooler URL (port 6543) — the same value the web app uses.
# The poller reads and writes the alerts tables directly.
DATABASE_URL=

# Optional. Appended to each digest so a truncated message has somewhere to link.
# ALERT_SITE_URL=https://your-app.vercel.app

# Optional. Comma-separated override of the terms to alert on. Defaults to
# Fall 2026, Spring 2027, Summer 2027, Winter 2027.
# ALERT_TERMS=Fall 2026,Spring 2027,Summer 2027,Winter 2027
