# Supabase transaction pooler URL (port 6543) — the same value the web app and
# the iMessage poller use. This bot only drains alert_delivery rows that the
# poller has already reserved; it never fetches a job board itself.
DATABASE_URL=

# Optional. The role a digest pings, as a numeric role ID — NOT a role name.
# "@job" typed literally is inert text in Discord; only <@&id> is a mention.
# Get it with Developer Mode on: Server Settings -> Roles -> right-click -> Copy
# Role ID. Unset means digests post silently.
# DISCORD_MENTION_ROLE_ID=

# Optional. Name and avatar the webhook posts under, overriding whatever the
# webhook was configured with in Discord.
# DISCORD_USERNAME=Internships
# DISCORD_AVATAR_URL=

# Webhook URLs are NOT configured here — they live in alert_subscriber.webhook_url,
# added from the Alerts tab, so one deployment can post to several channels.
