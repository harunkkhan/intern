# ----------------------------------------------------------------------------
# Copy this file to `.env.local` for local dev, and add the same values to the
# Vercel project's Environment Variables for production.
# ----------------------------------------------------------------------------

# Supabase project — Settings → API (or the "Connect" dialog).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # the "anon"/publishable key (sb_publishable_… or eyJ…)

# Supabase Postgres connection strings — "Connect" dialog.
#  - DATABASE_URL  -> Transaction pooler (port 6543). Used by the app at runtime.
#  - DIRECT_URL    -> Session pooler (port 5432). Used by drizzle-kit migrations.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Google OAuth client (Google Cloud Console → Credentials). The SAME client id
# and secret are also entered into Supabase (Auth → Providers → Google). The app
# needs them here too in order to refresh the Gmail access token from the cron.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The owner's Google account. Always allowed to sign in, and used by the daily
# cron to pick which inbox to scan. Additional users are granted access by adding
# rows to the `allowed_email` table (no redeploy needed) — this env var is the
# bootstrap so an empty table can never lock everyone out.
ALLOWED_EMAIL=you@gmail.com

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Shared secret protecting the daily cron route. Generate any random string.
# Vercel Cron automatically sends this as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Optional: absolute site URL used to build the OAuth redirect when the request
# origin can't be inferred. Set in production if sign-in redirects misbehave.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Only emails on/after this date are tracked (YYYY-MM-DD). Defaults to 2026-06-24.
TRACK_AFTER=2026-06-24

# Optional: override the Gmail search used to find candidate emails.
# GMAIL_QUERY=
